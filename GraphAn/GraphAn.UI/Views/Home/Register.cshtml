@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Реєстрація</h4>
        </div>
        <div class="card-body">
            <form id="registerForm">
                <div class="mb-3">
                    <label for="username" class="form-label">Ім'я користувача (логін)</label>
                    <input type="text" class="form-control" id="username" name="username" required>
                    <div class="invalid-feedback">Будь ласка, введіть ім'я користувача.</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Електронна пошта</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                    <div class="invalid-feedback">Введіть коректну email адресу.</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Пароль</label>
                    <input type="password" class="form-control" id="password" name="password" required minlength="6">
                    <div class="invalid-feedback">Пароль має містити щонайменше 6 символів.</div>
                </div>
                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Підтвердження пароля</label>
                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
                    <div class="invalid-feedback">Паролі не співпадають.</div>
                </div>
                <button type="submit" class="btn btn-success w-100">Зареєструватися</button>
            </form>

            <div id="message" class="mt-3"></div>
            <hr />
            <div class="text-center">
                <small>Вже маєте акаунт? <a href="/home/login">Увійти</a></small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('registerForm');
        const messageDiv = document.getElementById('message');

        // Перевірка співпадіння паролів
        function validatePasswords() {
            const password = document.getElementById('password').value;
            const confirm = document.getElementById('confirmPassword').value;
            if (password !== confirm) {
                document.getElementById('confirmPassword').setCustomValidity('Паролі не співпадають');
                return false;
            } else {
                document.getElementById('confirmPassword').setCustomValidity('');
                return true;
            }
        }

        document.getElementById('confirmPassword').addEventListener('input', validatePasswords);
        document.getElementById('password').addEventListener('input', validatePasswords);

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            if (!validatePasswords()) {
                return;
            }

            const username = document.getElementById('username').value.trim();
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;

            if (!username || !email || !password) {
                showMessage('Заповніть всі поля.', 'danger');
                return;
            }

            try {
                const response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName: username, email, password })
                });
                const data = await response.json();

                if (response.ok) {
                    showMessage('Реєстрацію розпочато! Код підтвердження надіслано на вашу пошту.', 'success');
                    setTimeout(() => {
                        window.location.href = '/home/confirm';
                    }, 2000);
                } else {
                    showMessage(data.message || 'Помилка реєстрації. Спробуйте ще раз.', 'danger');
                }
            } catch (error) {
                showMessage('Помилка з\'єднання з сервером.', 'danger');
            }
        });

        function showMessage(msg, type) {
            messageDiv.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                                        ${msg}
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>`;
            setTimeout(() => {
                const alert = messageDiv.querySelector('.alert');
                if (alert) alert.classList.remove('show');
            }, 5000);
        }
    </script>
}
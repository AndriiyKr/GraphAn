@{
    ViewData["Title"] = "Скидання пароля";
    var email = ViewBag.Email as string;
    var token = ViewBag.Token as string;
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 100px);">
    <div class="card shadow-sm border-0 rounded-4" style="width: 100%; max-width: 450px; background-color: #ffffff;">
        <div class="card-body p-4 p-md-5">

            @if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(token))
            {
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-3 shadow-sm" style="width: 65px; height: 65px;">
                        <i class="fa-solid fa-link-slash fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Помилка посилання</h3>
                    <p class="text-muted small mb-4">
                        Некоректне або застаріле посилання для скидання пароля. Будь ласка, спробуйте зробити запит ще раз.
                    </p>
                    <a asp-controller="Home" asp-action="ForgotPassword" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm">
                        ПОВТОРИТИ ЗАПИТ
                    </a>
                </div>
            }
            else
            {
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3 shadow-sm" style="width: 65px; height: 65px;">
                        <i class="fa-solid fa-key fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Створення пароля</h3>
                    <p class="text-muted small">Введіть новий надійний пароль для вашого акаунту</p>
                </div>

                <form id="resetForm">
                    <input type="hidden" id="email" value="@email" />
                    <input type="hidden" id="token" value="@token" />

                    <div id="reset-alert" class="alert d-none rounded-3 py-2 small mb-3 text-center"></div>

                    <div class="form-floating mb-3">
                        <input type="password" class="form-control rounded-3" id="newPassword" placeholder="Новий пароль" minlength="8" required>
                        <label for="newPassword"><i class="fa-solid fa-lock me-2 text-muted"></i>Новий пароль (від 8 симв.)</label>
                    </div>

                    <div class="form-floating mb-4">
                        <input type="password" class="form-control rounded-3" id="confirmPassword" placeholder="Підтвердіть пароль" required>
                        <label for="confirmPassword"><i class="fa-solid fa-shield-halved me-2 text-muted"></i>Підтвердіть пароль</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm mb-3">
                        ЗБЕРЕГТИ ПАРОЛЬ
                    </button>
                </form>

                <div class="text-center mt-2">
                    <a asp-controller="Home" asp-action="Login" class="text-primary text-decoration-none fw-bold small">
                        <i class="fa-solid fa-arrow-left me-1 small"></i> Повернутися до входу
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('resetForm');

        if (form) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const alertDiv = document.getElementById('reset-alert');
                const btn = this.querySelector('button[type="submit"]');

                // Скидаємо стан
                alertDiv.classList.add('d-none');

                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                // Валідація на клієнті (співпадіння)
                if (newPassword !== confirmPassword) {
                    alertDiv.textContent = 'Паролі не співпадають';
                    alertDiv.className = 'alert alert-danger rounded-3 py-2 small mb-3 text-center';
                    alertDiv.classList.remove('d-none');
                    return;
                }

                // Блокуємо кнопку під час запиту
                btn.disabled = true;
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Зачекайте...';

                const email = document.getElementById('email').value;
                const token = document.getElementById('token').value;

                try {
                    const response = await fetch('/api/auth/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email, token, newPassword })
                    });
                    const data = await response.json();

                    if (response.ok) {
                        alertDiv.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i>Пароль успішно змінено! Перенаправлення...';
                        alertDiv.className = 'alert alert-success rounded-3 py-2 small mb-3 text-center fw-bold';
                        alertDiv.classList.remove('d-none');
                        setTimeout(() => {
                            window.location.href = '/Home/Login';
                        }, 2000);
                    } else {
                        alertDiv.textContent = data.message || 'Помилка скидання пароля.';
                        alertDiv.className = 'alert alert-danger rounded-3 py-2 small mb-3 text-center';
                        alertDiv.classList.remove('d-none');
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }
                } catch (err) {
                    alertDiv.textContent = 'Помилка з\'єднання з сервером.';
                    alertDiv.className = 'alert alert-danger rounded-3 py-2 small mb-3 text-center';
                    alertDiv.classList.remove('d-none');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        }
    </script>
}

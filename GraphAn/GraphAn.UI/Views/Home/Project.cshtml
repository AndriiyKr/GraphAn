@model GraphAn.UI.ViewModels.ProjectViewModel
@{
    if (Model != null) { ViewData["Title"] = Model.Name ?? "Новий проєкт"; }
    else { ViewData["Title"] = "Новий проєкт"; }

    string projectId = Model?.ProjectId.ToString() ?? Guid.Empty.ToString();
    string initialGraphJson = (Model != null && !string.IsNullOrEmpty(Model.GraphData)) ? Model.GraphData : "{}";
    // Отримуємо чисту назву проєкту для збереження
    string cleanProjectName = Model?.Name ?? "Новий проєкт";
}

@section Styles {
    <link rel="stylesheet" href="~/css/canvas.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
}

<div class="editor-interface">
    <div class="canvas-area">
        <div class="canvas-toolbar shadow-sm">
            <button id="btn-select" class="t-btn active" title="Курсор"><i class="fa-solid fa-arrow-pointer"></i></button>
            <button id="btn-add-node" class="t-btn" title="Вершина"><i class="fa-solid fa-circle"></i></button>
            <button id="btn-add-edge" class="t-btn" title="Ребро"><i class="fa-solid fa-minus"></i></button>
            <button id="btn-add-dir-edge" class="t-btn" title="Дуга"><i class="fa-solid fa-long-arrow-right"></i></button>
            <button id="btn-add-loop" class="t-btn" title="Петля"><i class="fa-solid fa-rotate-left"></i></button>
            <button id="btn-rename" class="t-btn" title="Назва вершини"><i class="fa-solid fa-font"></i></button>
            <button id="btn-weight" class="t-btn" title="Вага ребра"><i class="fa-solid fa-weight-hanging"></i></button>
            <button id="btn-delete" class="t-btn" title="Гумка"><i class="fa-solid fa-eraser"></i></button>
            <div class="t-sep"></div>
            <button id="btn-clear" class="t-btn text-danger" title="Очищення"><i class="fa-solid fa-trash-can"></i></button>
        </div>

        <div id="canvas-viewport" class="canvas-viewport">
            <svg id="graph-canvas" width="3000" height="3000">
                <defs>
                    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#f0f0f0" stroke-width="1" />
                    </pattern>
                    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="28" refY="3.5" orient="auto">
                        <polygon points="0 0, 10 3.5, 0 7" fill="#333" />
                    </marker>
                </defs>
                <g id="zoom-group">
                    <rect width="3000" height="3000" fill="url(#grid)" />
                    <g id="main-group"></g>
                </g>
            </svg>
        </div>
    </div>

    <div class="sidebar-panel shadow-sm">
        <div class="panel-section">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="m-0 fw-bold">АНАЛІЗ ГРАФІВ</h4>
                <i class="fa-solid fa-circle-info text-muted"></i>
            </div>
            <div class="d-flex mb-4">
                <button id="btn-analyze" class="btn btn-dark w-100 py-2 rounded-3">АНАЛІЗУВАТИ</button>
            </div>
        </div>

        <div class="panel-section">
            <h6 class="text-uppercase fw-bold text-muted mb-3"><i class="fa-solid fa-chart-line me-2"></i>Характеристики</h6>
            <div id="stats-container" class="empty-state rounded-4">
                ДАНІ ВІДСУТНІ. НАМАЛЮЙТЕ ГРАФ ТА НАТИСНІТЬ КНОПКУ "АНАЛІЗУВАТИ".
            </div>
        </div>

        <div class="panel-section mt-auto">
            <h6 class="text-uppercase fw-bold text-muted mb-3"><i class="fa-solid fa-gears me-2"></i>Алгоритми</h6>
            <div class="algorithm-item mb-3 bg-light p-3 rounded-4 border">
                <label class="small fw-bold mb-2">АЛГОРИТМ ДЕЙКСТРИ</label>
                <div class="row g-2">
                    <div class="col-6"><select id="dijkstra-start" class="form-select form-select-sm rounded-3"><option>Початкова</option></select></div>
                    <div class="col-6"><select id="dijkstra-end" class="form-select form-select-sm rounded-3"><option>Кінцева</option></select></div>
                </div>
            </div>
        </div>

        <div class="pt-3">
            <button id="btn-save-project" class="btn btn-primary w-100 rounded-3 py-2"><i class="fa-solid fa-floppy-disk me-2"></i>Зберегти проєкт</button>
        </div>
    </div>
</div>

<div class="modal fade" id="modalWeight" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">Вага ребра</h6>
            </div>
            <div class="modal-body">
                <input type="number" id="input-weight" class="form-control rounded-3" placeholder="Введіть число...">
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-primary w-100 rounded-3" id="save-weight">Зберегти</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRename" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">Назва вершини</h6>
            </div>
            <div class="modal-body">
                <input type="text" id="input-rename" class="form-control rounded-3" maxlength="4" placeholder="max 4 симв.">
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-primary w-100 rounded-3" id="save-rename">Зберегти</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/canvas.js" asp-append-version="true"></script>
    <script>
        const projectId = '@projectId';
        const projectName = '@Html.Raw(cleanProjectName)'; // Використовуємо змінну з чистою назвою
        const initialData = @Html.Raw(initialGraphJson);

        document.addEventListener("DOMContentLoaded", () => {
            // Завантаження початкових даних (якщо є)
            if (window.graphEditor && initialData && initialData.nodes) {
                window.graphEditor.nodes = initialData.nodes;
                window.graphEditor.edges = initialData.edges || [];
                window.graphEditor.isDirectedGraph = initialData.directed !== undefined ? initialData.directed : null;

                window.graphEditor.nodeCounter = initialData.nodes.length > 0
                    ? Math.max(...initialData.nodes.map(n => parseInt(n.id.toString().replace('v', '')) || 0)) + 1
                    : 1;

                window.graphEditor.updateToolbarStates();
                window.graphEditor.render();
            }

            // Робоча кнопка "Зберегти проєкт"
            document.getElementById('btn-save-project').addEventListener('click', async () => {
                if (!window.graphEditor) return;

                const btn = document.getElementById('btn-save-project');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Збереження...';
                btn.disabled = true;

                // Формуємо об'єкт так, як очікує бекенд
                const graphDataObj = {
                    nodes: window.graphEditor.nodes,
                    edges: window.graphEditor.edges,
                    directed: window.graphEditor.isDirectedGraph !== null ? window.graphEditor.isDirectedGraph : false
                };

                try {
                    const response = await fetch('/api/project/save', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            projectId: projectId,
                            name: projectName, // Передаємо виключно чисту назву без " - GraphAn"
                            graphData: JSON.stringify(graphDataObj)
                        })
                    });

                    if (response.ok) {
                        alert('✅ Проєкт успішно збережено!');
                    } else {
                        alert('❌ Помилка при збереженні проєкту.');
                    }
                } catch (err) {
                    console.error(err);
                    alert('❌ Помилка з\'єднання з сервером.');
                } finally {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        });
    </script>
}
@{
    ViewData["Title"] = "Реєстрація";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 100px);">
    <div class="card shadow-sm border-0 rounded-4" style="width: 100%; max-width: 450px; background-color: #ffffff;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-dark text-white rounded-circle mb-3 shadow-sm" style="width: 65px; height: 65px;">
                    <i class="fa-solid fa-user-plus fa-2x"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Створити акаунт</h3>
                <p class="text-muted small">Приєднуйтесь до платформи GraphAn</p>
            </div>

            <form id="registerForm" method="post">
                <div id="reg-alert" class="alert d-none rounded-3 py-2 small mb-3 text-center"></div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control rounded-3" id="usernameInput" name="UserName" placeholder="Ваш логін" required>
                    <label for="usernameInput"><i class="fa-solid fa-user me-2 text-muted"></i>Ім'я користувача</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="email" class="form-control rounded-3" id="emailInput" name="Email" placeholder="name@example.com" required>
                    <label for="emailInput"><i class="fa-solid fa-envelope me-2 text-muted"></i>Електронна пошта</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" class="form-control rounded-3" id="passwordInput" name="Password" placeholder="Пароль" minlength="8" required>
                    <label for="passwordInput"><i class="fa-solid fa-lock me-2 text-muted"></i>Пароль (від 8 симв.)</label>
                </div>

                <div class="form-floating mb-4">
                    <input type="password" class="form-control rounded-3" id="confirmPasswordInput" placeholder="Підтвердіть пароль" required>
                    <label for="confirmPasswordInput"><i class="fa-solid fa-shield-halved me-2 text-muted"></i>Підтвердіть пароль</label>
                </div>

                <button type="submit" class="btn btn-dark w-100 py-3 rounded-3 fw-bold shadow-sm mb-3">
                    ЗАРЕЄСТРУВАТИСЯ
                </button>
            </form>

            <div class="text-center">
                <span class="text-muted small">Вже є акаунт?</span>
                <a href="/Home/Login" class="text-primary text-decoration-none fw-bold small">Увійти</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const alertDiv = document.getElementById('reg-alert');
            const btn = this.querySelector('button[type="submit"]');

            // Скидаємо стан
            alertDiv.classList.add('d-none');

            const password = document.getElementById('passwordInput').value;
            const confirmPassword = document.getElementById('confirmPasswordInput').value;

            // Перевірка на співпадіння паролів на фронтенді
            if (password !== confirmPassword) {
                alertDiv.textContent = 'Паролі не співпадають';
                alertDiv.className = 'alert alert-danger rounded-3 py-2 small mb-3 text-center';
                alertDiv.classList.remove('d-none');
                return;
            }

            btn.disabled = true;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Зачекайте...';

            const email = document.getElementById('emailInput').value;
            const data = {
                userName: document.getElementById('usernameInput').value,
                email: email,
                password: password
            };

            try {
                const response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();

                if (response.ok) {
                    window.location.href = '/Home/Confirm?email=' + encodeURIComponent(email);
                } else {
                    alertDiv.textContent = result.message || 'Помилка реєстрації';
                    alertDiv.className = 'alert alert-danger rounded-3 py-2 small mb-3 text-center';
                    alertDiv.classList.remove('d-none');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (err) {
                alertDiv.textContent = 'Помилка з\'єднання з сервером';
                alertDiv.className = 'alert alert-danger rounded-3 py-2 small mb-3 text-center';
                alertDiv.classList.remove('d-none');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });
    </script>
}

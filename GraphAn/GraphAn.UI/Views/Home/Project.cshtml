@model GraphAn.UI.ViewModels.ProjectViewModel
@{
    if (Model != null) { ViewData["Title"] = Model.Name ?? "Новий проєкт"; }
    else { ViewData["Title"] = "Новий проєкт"; }

    string projectId = Model?.ProjectId.ToString() ?? Guid.Empty.ToString();
    string initialGraphJson = (Model != null && !string.IsNullOrEmpty(Model.GraphData)) ? Model.GraphData : "{}";
    // Отримуємо чисту назву проєкту для збереження
    string cleanProjectName = Model?.Name ?? "Новий проєкт";
    ViewData["IsCanvasPage"] = true; // mark this page as canvas so layout won't load site-pages.css
}

@section Styles {
    <link rel="stylesheet" href="~/css/canvas.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        /* highlights for algorithm results */
        .node-group.highlight .graph-node { stroke: #ff8a00; stroke-width: 4px; }
        .edge-weight-group.highlight-edge .graph-edge { stroke: #ff8a00 !important; stroke-width: 4px !important; }
        .algorithm-result { font-size: 0.95rem; }
        .algorithm-result pre { white-space: pre-wrap; }
        /* Floyd matrices styling */
        .floyd-matrices { margin-top: 1rem; }
        .matrix-table { width:100%; border-collapse:collapse; border-radius:12px; overflow:hidden; }
        .matrix-table th, .matrix-table td { padding: 10px; text-align:center; border-bottom:1px solid rgba(0,0,0,0.04); }
        .matrix-table thead th { background:#f8fafc; font-weight:700; }
        .matrix-cell.clickable { cursor:pointer; color:#4f46e5; }
        .floyd-stepper { background:#0f172a; color:#fff; padding:14px; border-radius:10px; text-align:center; margin-top:12px; }
        /* DFS/BFS traversal table */
        .traversal-table { width:100%; border-collapse:collapse; margin-top:12px; }
        .traversal-table th, .traversal-table td { padding:12px 10px; border-bottom:1px solid rgba(0,0,0,0.04); text-align:center; }
        .traversal-table thead th { background:#0f172a; color:#fff; font-weight:700; text-align:center; }
        .traversal-backtrack { color:#94a3b8; font-style:italic; }
        /* Dijkstra weight box */
        .weight-box { background:#0f172a; color:#fff; border-radius:12px; padding:24px; text-align:center; margin-top:12px; box-shadow:0 8px 20px rgba(15,23,42,0.08); }
        .weight-box .label { font-size:0.85rem; color:#9ca3af; text-transform:uppercase; letter-spacing:1px; }
        .weight-box .value { font-size:40px; font-weight:800; margin-top:6px; }
        .path-small { color:#374151; margin-top:8px; }

        .analysis-section { margin-top: 20px; }
        .analysis-section h6 { font-size: 1rem; font-weight: bold; margin-bottom: 10px; }
        .analysis-section .value { font-size: 1.5rem; font-weight: bold; color: #1d4ed8; }
        .analysis-section .text-muted { font-style: italic; color: #6b7280; }
        .matrix-table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        .matrix-table th, .matrix-table td { padding: 12px; text-align: center; border-bottom: 1px solid rgba(0, 0, 0, 0.04); }
        .matrix-table thead th { background: #f8fafc; font-weight: 700; }
    </style>
}

<div class="editor-interface">
    <div class="canvas-area">
        <div class="canvas-toolbar shadow-sm">
            <button id="btn-select" class="t-btn active" title="Курсор"><i class="fa-solid fa-arrow-pointer"></i></button>
            <button id="btn-add-node" class="t-btn" title="Вершина"><i class="fa-solid fa-circle"></i></button>
            <button id="btn-add-edge" class="t-btn" title="Ребро"><i class="fa-solid fa-minus"></i></button>
            <button id="btn-add-dir-edge" class="t-btn" title="Дуга"><i class="fa-solid fa-long-arrow-right"></i></button>
            <button id="btn-add-loop" class="t-btn" title="Петля"><i class="fa-solid fa-rotate-left"></i></button>
            <button id="btn-rename" class="t-btn" title="Назва вершини"><i class="fa-solid fa-font"></i></button>
            <button id="btn-weight" class="t-btn" title="Вага ребра"><i class="fa-solid fa-weight-hanging"></i></button>
            <button id="btn-delete" class="t-btn" title="Гумка"><i class="fa-solid fa-eraser"></i></button>
            <div class="t-sep"></div>
            <button id="btn-clear" class="t-btn text-danger" title="Очищення"><i class="fa-solid fa-trash-can"></i></button>
        </div>

        <div id="canvas-viewport" class="canvas-viewport">
            <svg id="graph-canvas" width="3000" height="3000">
                <defs>
                    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#f0f0f0" stroke-width="1" />
                    </pattern>
                    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="28" refY="3.5" orient="auto">
                        <polygon points="0 0, 10 3.5, 0 7" fill="#333" />
                    </marker>
                </defs>
                <g id="zoom-group">
                    <rect width="3000" height="3000" fill="url(#grid)" />
                    <g id="main-group"></g>
                </g>
            </svg>
        </div>
    </div>

    <div class="sidebar-panel shadow-sm">
        <div class="panel-section">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="m-0 fw-bold">АНАЛІЗ ГРАФІВ</h4>
                <i class="fa-solid fa-circle-info text-muted"></i>
            </div>
            <div class="d-flex mb-4">
                <button id="btn-analyze" class="btn btn-dark w-100 py-2 rounded-3">АНАЛІЗУВАТИ</button>
            </div>
        </div>

        <div class="panel-section">
            <h6 class="text-uppercase fw-bold text-muted mb-3"><i class="fa-solid fa-chart-line me-2"></i>Характеристики</h6>
            <div id="stats-container" class="empty-state rounded-4">
                ДАНІ ВІДСУТНІ. НАМАЛЮЙТЕ ГРАФ ТА НАТИСНІТЬ КНОПКУ "АНАЛІЗУВАТИ".
            </div>
        </div>

        <div class="panel-section mt-auto">
            <h6 class="text-uppercase fw-bold text-muted mb-3"><i class="fa-solid fa-gears me-2"></i>Алгоритми</h6>

            <div class="algorithm-item mb-3 bg-light p-3 rounded-4 border">
                <label class="small fw-bold mb-2">АЛГОРИТМ ДЕЙКСТРИ</label>
                <div class="row g-2 mb-2">
                    <div class="col-6"><select id="dijkstra-start" class="form-select form-select-sm rounded-3"><option value="">Початкова</option></select></div>
                    <div class="col-6"><select id="dijkstra-end" class="form-select form-select-sm rounded-3"><option value="">Кінцева</option></select></div>
                </div>
                 <div class="d-flex justify-content-end mb-2">
                    <button id="floyd-clear-highlights" class="btn btn-sm btn-outline-secondary">Очистити підсвічування</button>
                </div>
                <div class="d-grid">
                    <button id="run-dijkstra" class="btn btn-sm btn-primary">Обчислити найкоротший шлях</button>
                </div>

                <!-- Dijkstra result placed directly under its block -->
                <div id="dijkstra-result" class="mt-3"></div>
            </div>

            <div class="algorithm-item mb-3 bg-light p-3 rounded-4 border">
                <label class="small fw-bold mb-2">ПОШУК У ГЛИБИНУ (DFS)</label>
                <div class="mb-2"><select id="dfs-start" class="form-select form-select-sm rounded-3"><option value="">Виберіть вершину</option></select></div>
                <div class="d-grid"><button id="run-dfs" class="btn btn-sm btn-primary">Запустити DFS обхід</button></div>

                <!-- DFS result placed under its block -->
                <div id="dfs-result" class="mt-3"></div>
            </div>

            <div class="algorithm-item mb-3 bg-light p-3 rounded-4 border">
                <label class="small fw-bold mb-2">ПОШУК У ШИРИНУ (BFS)</label>
                <div class="mb-2"><select id="bfs-start" class="form-select form-select-sm rounded-3"><option value="">Виберіть вершину</option></select></div>
                <div class="d-grid"><button id="run-bfs" class="btn btn-sm btn-primary">Запустити BFS обхід</button></div>

                <!-- BFS result placed under its block -->
                <div id="bfs-result" class="mt-3"></div>
            </div>

            <div class="algorithm-item mb-3 bg-light p-3 rounded-4 border">
                <label class="small fw-bold mb-2">АЛГОРИТМ ФЛОЙДА-ВОРШЕЛА</label>
                <div class="d-grid mb-2"><button id="run-floyd" class="btn btn-sm btn-primary">Побудувати матриці шляхів</button></div>
                <div id="floyd-container" class="floyd-matrices" style="display:none;">
                    <div class="floyd-stepper d-flex justify-content-between align-items-center mb-3">
                        <button id="floyd-prev" class="btn btn-ghost btn-sm text-white"><i class="fa-solid fa-chevron-left"></i></button>
                        <div>
                            <div class="small text-uppercase">Поточний крок</div>
                            <div id="floyd-step-title" class="fw-bold">—</div>
                        </div>
                        <button id="floyd-next" class="btn btn-ghost btn-sm text-white"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>

                    <div class="d-flex justify-content-end mb-2">
                        <button id="floyd-clear-highlights" class="btn btn-sm btn-outline-secondary">Очистити підсвічування</button>
                    </div>

                    <div>
                        <h6 class="small text-muted">Матриця відстаней M(<span id="floyd-step-index">0</span>)</h6>
                        <div id="floyd-distance" class="mb-3"></div>
                    </div>
                    <div>
                        <h6 class="small text-muted">Матриця предків T(<span id="floyd-step-index-2">0</span>)</h6>
                        <div id="floyd-predecessor"></div>
                    </div>
                    <div class="mt-2"><small class="text-muted">Порада: клацніть на будь-яку клітинку в матриці M, щоб підсвітити шлях між вершинами на графі.</small></div>
                </div>
            </div>

            <div id="algorithm-result" class="mt-3 algorithm-result"></div>
        </div>

        <div class="pt-3">
            <button id="btn-save-project" class="btn btn-primary w-100 rounded-3 py-2"><i class="fa-solid fa-floppy-disk me-2"></i>Зберегти проєкт</button>
        </div>
    </div>
</div>

<div class="modal fade" id="modalWeight" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">Вага ребра</h6>
            </div>
            <div class="modal-body">
                <input type="number" id="input-weight" class="form-control rounded-3" placeholder="Введіть число...">
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-primary w-100 rounded-3" id="save-weight">Зберегти</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRename" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">Назва вершини</h6>
            </div>
            <div class="modal-body">
                <input type="text" id="input-rename" class="form-control rounded-3" maxlength="4" placeholder="max 4 симв.">
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-primary w-100 rounded-3" id="save-rename">Зберегти</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/canvas.js" asp-append-version="true"></script>
    <script>
        const projectId = '@projectId';
        const projectName = '@Html.Raw(cleanProjectName)'; // Використовуємо змінну з чистою назвою
        const initialData = @Html.Raw(initialGraphJson);

        // helper to render traversal protocol (DFS/BFS)
        function renderTraversalResult(traversal, containerId, type = 'DFS') {
            const container = document.getElementById(containerId || 'algorithm-result');
            if (!traversal || !traversal.protocol) { container.innerHTML = '<div class="text-muted">Немає даних</div>'; return; }
            let html = '';
            const collectionLabel = type.toUpperCase() === 'BFS' ? 'Черга' : 'Стек';
            html += '<table class="traversal-table"><thead><tr><th>V</th><th>№</th><th>${collectionLabel}</th><th>Ребро</th></tr></thead><tbody>';
            traversal.protocol.forEach(step => {
                const v = step.vertex || '—';
                const num = (step.stepNumber !== null && step.stepNumber !== undefined) ? step.stepNumber : '—';
                const stack = (step.collection && step.collection.length) ? step.collection.join(', ') : '∅';
                const edge = step.treeEdge || '—';
                const isBack = (edge === 'backtrack' || v === '—');
                html += `<tr ${isBack ? 'class="traversal-backtrack"' : ''}>`;
                html += `<td>${v}</td><td>${num}</td><td>${stack}</td><td><small class="text-muted">${edge}</small></td>`;
                html += '</tr>';
            });
            html += '</tbody></table>';
            container.innerHTML = html;
        }

        // helper to render dijkstra result: weight box + path
        function renderDijkstraResult(dijkstra) {
            const container = document.getElementById('dijkstra-result');
            if (!dijkstra) { container.innerHTML = '<div class="text-muted">Немає даних</div>'; return; }
            const weight = (dijkstra.totalWeight !== undefined && dijkstra.totalWeight !== null) ? dijkstra.totalWeight : dijkstra.totalweight ?? 0;
            const path = dijkstra.pathNodes && dijkstra.pathNodes.length ? dijkstra.pathNodes.join(' → ') : '—';
            let html = '';
            html += `<div class="weight-box"><div class="label">Загальна вага шляху</div><div class="value">${weight}</div></div>`;
            html += `<div class="path-small">Шлях: ${path}</div>`;
            container.innerHTML = html;
        }

        // Define helpers early so they are available when floyd step rendering runs
        window.buildMatrixTable = function(mat, labels, clickable) {
            let html = '<table class="matrix-table"><thead><tr><th>i \\ j</th>';
            for (let li = 0; li < labels.length; li++) html += `<th>${labels[li]}</th>`;
            html += '</tr></thead><tbody>';
            for (let i = 0; i < mat.length; i++) {
                html += '<tr>';
                html += `<th>${labels[i]}</th>`;
                for (let j = 0; j < mat[i].length; j++) {
                    const val = mat[i][j];
                    const display = (val === null || val === undefined) ? '—' : val;
                    const cls = (clickable ? 'matrix-cell clickable' : 'matrix-cell');
                    html += `<td class="${cls}" data-row="${i}" data-col="${j}">${display}</td>`;
                }
                html += '</tr>';
            }
            html += '</tbody></table>';
            return html;
        };

        window.highlightPathFromFloyd = function(i, j) {
            clearHighlights();
            if (!floydResult) return;
            const labels = floydResult.labels || [];
            if (i < 0 || j < 0 || i >= labels.length || j >= labels.length) return;
            const step = floydResult.steps[floydCurrentStep];
            const pred = step.predecessorMatrix;
            function reconstruct(iIdx, jIdx) {
                const path = [];
                if (!pred || !pred[iIdx] || pred[iIdx][jIdx] == null) return path;
                if (iIdx === jIdx) { return [iIdx]; }
                let current = jIdx;
                path.unshift(current);
                const maxIter = labels.length * 2;
                let iter = 0;
                while (current !== iIdx && iter < maxIter) {
                    const p = pred[iIdx][current];
                    if (p == null || p <= 0) break;
                    const pIdx = p - 1;
                    if (pIdx === current) break;
                    path.unshift(pIdx);
                    current = pIdx;
                    iter++;
                }
                if (path[0] !== iIdx) {
                    if (pred[iIdx] && pred[iIdx][jIdx] === iIdx + 1) {
                        return [iIdx, jIdx];
                    }
                }
                return path;
            }

            const idxPath = reconstruct(i, j);
            if (!idxPath || idxPath.length < 2) return;
            const labelToNodeId = {};
            (window.graphEditor?.nodes || []).forEach(n => labelToNodeId[n.label] = n.id);
            const nodeIds = idxPath.map(k => labelToNodeId[labels[k]]).filter(x=>x!==undefined);
            for (let k = 0; k < nodeIds.length - 1; k++) {
                const a = nodeIds[k];
                const b = nodeIds[k+1];
                const edge = (window.graphEditor?.edges || []).find(e => (e.source == a && e.target == b) || (!window.graphEditor.isDirectedGraph && e.source == b && e.target == a));
                if (edge) {
                    const g = document.querySelector(`.edge-weight-group[data-id="${edge.id}"]`);
                    if (g) g.classList.add('highlight-edge');
                }
                const nodeEl = document.querySelector(`.node-group[data-id="${a}"]`);
                if (nodeEl) nodeEl.classList.add('highlight');
                const nodeEl2 = document.querySelector(`.node-group[data-id="${b}"]`);
                if (nodeEl2) nodeEl2.classList.add('highlight');
            }
        };

        function buildGraphDto() {
            if (!window.graphEditor) return null;
            const nodes = window.graphEditor.nodes.map(n => ({ id: n.id.toString(), label: n.label }));
            const edges = window.graphEditor.edges.map(e => ({
                id: e.id.toString(),
                from: e.source.toString(),
                to: e.target.toString(),
                weight: (e.weight !== null && e.weight !== undefined) ? e.weight : 1,
                hasWeight: e.weight !== null && e.weight !== undefined
            }));
            return { nodes, edges, directed: !!window.graphEditor.isDirectedGraph };
        }

        function populateNodeSelects() {
            const nodes = (window.graphEditor && window.graphEditor.nodes) ? window.graphEditor.nodes : [];
            const selects = ['dijkstra-start','dijkstra-end','dfs-start','bfs-start'];
            selects.forEach(id => {
                const sel = document.getElementById(id);
                if (!sel) return;
                const current = sel.value;
                sel.innerHTML = '<option value="">—</option>';
                nodes.forEach(n => {
                    const opt = document.createElement('option');
                    opt.value = n.id.toString();
                    opt.text = n.label;
                    sel.appendChild(opt);
                });
                if (current) sel.value = current;
            });
        }

        async function analyzeAll() {
            clearHighlights();
            const dto = buildGraphDto();
            if (!dto) return alert('Граф відсутній або редактор не готовий');
            try {
                document.getElementById('btn-analyze').disabled = true;
                const resp = await fetch('/api/analysis/metrics', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ graphData: JSON.stringify(dto) })
                });
                if (!resp.ok) {
                    const err = await resp.json().catch(() => null);
                    throw new Error(err?.message || 'Помилка аналізу');
                }
                const res = await resp.json();
                renderAnalysis(res);
            } catch (err) {
                alert(err.message || err);
            } finally {
                document.getElementById('btn-analyze').disabled = false;
            }
        }

       // 1. ХАРАКТЕРИСТИКИ: Допоміжна функція побудови матриць (на всю ширину, з блідими нулями)
        function buildEnhancedMatrix(matrix, rowLabels, colLabels, cornerLabel) {
            if (!matrix || matrix.length === 0) return '<div class="text-muted py-2">Порожня матриця</div>';
            let html = '<table class="matrix-table w-100" style="font-size: 0.88rem; border-collapse: collapse; margin-top:0;">';
            html += `<thead><tr style="border-bottom: 2px solid #e2e8f0;"><th class="text-muted font-monospace p-2 text-center" style="background: #f8fafc;">${cornerLabel}</th>`;
            colLabels.forEach(cl => html += `<th class="fw-bold text-dark font-monospace p-2 text-center" style="min-width: 32px; background: #f8fafc;">${cl}</th>`);
            html += '</tr></thead><tbody>';
            for (let i = 0; i < matrix.length; i++) {
                html += '<tr style="border-bottom: 1px solid #edf2f7;">';
                html += `<th class="fw-bold text-secondary font-monospace p-2 text-center border-end" style="max-width: 50px; background: #f8fafc;">${rowLabels[i]}</th>`;
                for (let j = 0; j < matrix[i].length; j++) {
                    const val = matrix[i][j];
                    const style = (val === 0) ? 'style="opacity: 0.25; font-weight: 300;"' : 'style="font-weight: 700; color: #4f46e5;"';
                    html += `<td class="font-monospace p-2 text-center" ${style}>${val}</td>`;
                }
                html += '</tr>';
            }
            html += '</tbody></table>';
            return html;
        }

        const graphColorPalette = ["#ef4444", "#3b82f6", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899", "#14b8a6", "#f97316", "#64748b", "#06b6d4"];

        // 3. РЕНДЕРИНГ ПАНЕЛІ (Із вашого дизайну)
        function renderAnalysis(data) {
            const container = document.getElementById('stats-container');
            if (!data) { container.innerHTML = '<div class="text-muted text-center p-3">Немає даних</div>'; return; }

            const isDirected = data.adjacencyList && data.adjacencyList.adjacencyList.length > 0 && data.adjacencyList.adjacencyList[0].inDegree !== undefined;
            const matrixLabels = data.labels || data.adjacencyList?.adjacencyList.map(e => e.vertex) || Array.from({length: data.adjacencyMatrix?.length || 0}, (_, i) => `v${i+1}`);

            window.lastAnalysisData = data;
            let html = '';

            if (data.adjacencyMatrix) {
                html += `
                <div class="analysis-section mb-4 text-start">
                    <h6 class="text-uppercase text-muted fw-bold mb-2">Матриця суміжності</h6>
                    <div class="overflow-auto border rounded-3 p-2 bg-light">
                        ${buildEnhancedMatrix(data.adjacencyMatrix, matrixLabels, matrixLabels, "V \\ V")}
                    </div>
                </div>`;
            }

            if (data.incidenceMatrix) {
                const edgeCount = data.incidenceMatrix[0].length;
                let edgeLabels = [];
                if (data.edgeLabels && Array.isArray(data.edgeLabels) && data.edgeLabels.length === edgeCount) {
                    edgeLabels = data.edgeLabels;
                } else if (window.graphEditor && Array.isArray(window.graphEditor.edges) && Array.isArray(window.graphEditor.nodes)) {
                    // Build labels from current canvas edges in same order as graph DTO
                    const nodeLabelById = (window.graphEditor.nodes || []).reduce((acc, n) => { acc[n.id] = n.label; return acc; }, {});
                    edgeLabels = (window.graphEditor.edges || []).slice(0, edgeCount).map(e => {
                        const from = nodeLabelById[e.source] ?? e.source;
                        const to = nodeLabelById[e.target] ?? e.target;
                        return `{${from}, ${to}}`;
                    });
                    if (edgeLabels.length < edgeCount) {
                        // fallback to generic labels
                        edgeLabels = Array.from({length: edgeCount}, (_, j) => `e${j+1}`);
                    }
                } else {
                    edgeLabels = Array.from({length: edgeCount}, (_, j) => `e${j+1}`);
                }
                 html += `
                 <div class="analysis-section mb-4 text-start">
                     <h6 class="text-uppercase text-muted fw-bold mb-2">Матриця інцидентності</h6>
                     <div class="overflow-auto border rounded-3 p-2 bg-light">
                         ${buildEnhancedMatrix(data.incidenceMatrix, matrixLabels, edgeLabels, "V \\ E")}
                     </div>
                 </div>`;
            }

            if (data.adjacencyList && data.adjacencyList.adjacencyList) {
                html += `
                <div class="analysis-section mb-4 text-start">
                    <h6 class="text-uppercase text-muted fw-bold mb-2">Списки суміжності</h6>
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.9rem;">
                            <thead class="table-light"><tr><th class="ps-3">Вершина</th><th>Суміжні вершини</th></tr></thead>
                            <tbody>`;
                data.adjacencyList.adjacencyList.forEach(entry => {
                    html += `<tr>
                        <td class="ps-3 fw-bold font-monospace text-primary">${entry.vertex}</td>
                        <td class="text-dark font-monospace small">${entry.neighbors || '—'}</td>
                    </tr>`;
                });
                html += `</tbody></table></div></div>`;
            }

            if (data.info) {
                html += `
                <div class="analysis-section mb-4 text-start">
                    <h6 class="text-uppercase text-muted fw-bold mb-2">Загальна інформація</h6>
                    <div class="ps-3 d-flex flex-column gap-1 border-start border-2">
                        <div><strong>Тип графа:</strong> ${data.info.graphType || 'Неорієнтований'}</div>
                        <div><strong>Кількість вершин:</strong> ${data.info.nodeCount ?? 0}</div>`;
                
                if (data.cycleAndChromatic) {
                    html += `<div class="d-flex align-items-center">
                        <strong>Наявність циклів:</strong> <span class="ms-1">${data.cycleAndChromatic.hasCycle ? 'Так' : 'Ні'}</span>`;
                    if (data.cycleAndChromatic.hasCycle) {
                        html += `<button class="btn btn-outline-primary btn-sm py-0 px-2 rounded-2 ms-3 text-uppercase fw-bold font-monospace" id="flat-trigger-all-cycles" style="font-size: 0.72rem;">показати</button>`;
                    }
                    html += `</div>`;
                    if (data.cycleAndChromatic.hasCycle) {
                        html += `<div><strong>Довжина найкоротшого циклу:</strong> <span class="fw-bold text-dark font-monospace ms-1">${data.cycleAndChromatic.girth !== -1 ? data.cycleAndChromatic.girth : '—'}</span></div>`;
                    }
                }
                html += `</div></div>`;
            }

            if (data.adjacencyList && data.adjacencyList.adjacencyList) {
                html += `
                <div class="analysis-section mb-4 text-start">
                    <h6 class="text-uppercase text-muted fw-bold mb-2">Степені вершин</h6>
                    <div class="table-responsive rounded-3 border mb-2">
                        <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.9rem;">
                            <thead class="table-light"><tr><th class="ps-3">Вершина</th><th class="text-center">Степінь</th></tr></thead>
                            <tbody>`;
                data.adjacencyList.adjacencyList.forEach(entry => {
                    html += `<tr>
                        <td class="ps-3 font-monospace">${entry.vertex}</td>
                        <td class="text-center font-monospace fw-bold">${entry.degree ?? 0}</td>
                    </tr>`;
                });
                html += `</tbody></table></div>`;
                html += `<div class="ps-2 small fw-bold font-monospace text-uppercase ${data.adjacencyList.isRegular ? 'text-success' : 'text-danger'}">
                    Регулярність: ${data.adjacencyList.isRegular ? 'ГРАФ Є РЕГУЛЯРНИЙ' : 'ГРАФ НЕ Є РЕГУЛЯРНИЙ'}
                </div></div>`;
            }

            if (data.connectivity) {
                html += `
                <div class="analysis-section mb-4 text-start">
                    <h6 class="text-uppercase text-muted fw-bold mb-2">Зв’язність</h6>
                    <div class="ps-3 d-flex flex-column gap-1 border-start border-2">
                        <div><strong>Кількість компонент зв’язності:</strong> ${data.connectivity.componentsCount ?? 1}</div>
                        <div><strong>Число вершинної зв’язності &kappa;(G):</strong> ${data.connectivity.vertexConnectivity ?? '—'}</div>
                        <div><strong>Число реберної зв’язності &lambda;(G):</strong> ${data.connectivity.edgeConnectivity ?? '—'}</div>
                    </div>
                </div>`;
            }

            html += `
            <div class="analysis-section mb-4 text-start">
                <h6 class="text-uppercase text-muted fw-bold mb-1">Ейлерові структури</h6>
                <div class="ps-3 text-muted small">${(data.eulerianStructures && data.eulerianStructures.length) ? data.eulerianStructures.join(', ') : 'Ейлерових структур не знайдено'}</div>
            </div>`;

            html += `
            <div class="analysis-section mb-4 text-start">
                <h6 class="text-uppercase text-muted fw-bold mb-1">Гамільтонові структури</h6>
                <div class="ps-3 text-muted small">${(data.hamiltonianStructures && data.hamiltonianStructures.length) ? data.hamiltonianStructures.join(', ') : 'Гамільтонових структур не знайдено'}</div>
            </div>`;

            if (data.cycleAndChromatic || data.independenceAndClique) {
                html += `
                <div class="analysis-section mb-4 text-start">
                    <h6 class="text-uppercase text-muted fw-bold mb-2">Числові інваріанти</h6>
                    <div class="ps-3 d-flex flex-column gap-1 border-start border-2">
                        <div class="d-flex align-items-center">
                            <strong>Хроматичне число &chi;(G):</strong> <span class="ms-1 fw-bold">${data.cycleAndChromatic?.chromaticNumber ?? '—'}</span>
                            <button class="btn btn-outline-primary btn-sm py-0 px-2 rounded-2 ms-3 text-uppercase fw-bold font-monospace" id="flat-trigger-chromatic-coloring" style="font-size: 0.72rem;">розфарбувати</button>
                        </div>
                        <div><strong>Клікове число &omega;(G):</strong> <span class="font-monospace ms-1">${data.independenceAndClique?.cliqueNumber ?? '—'}</span></div>
                        <div><strong>Число незалежності &alpha;(G):</strong> <span class="font-monospace ms-1">${data.independenceAndClique?.independenceNumber ?? '—'}</span></div>
                    </div>
                </div>`;
            }

            container.innerHTML = html;
            initInteractiveMetricsHandlers();
        }

        function initInteractiveMetricsHandlers() {
            const data = window.lastAnalysisData;
            if (!data) return;

            // Скидання: прибираємо класи і стилі
            function resetAllCanvasHighlights() {
                if (!window.graphEditor) return;
                document.querySelectorAll('.node-group').forEach(el => el.classList.remove('highlight'));
                document.querySelectorAll('.edge-weight-group').forEach(el => el.classList.remove('highlight-edge'));
                
                // Очищаємо інлайнові стилі, які блокували перемальовку
                document.querySelectorAll('.graph-node, circle').forEach(c => { 
                    c.style.removeProperty('fill'); c.style.removeProperty('stroke'); c.style.removeProperty('stroke-width'); 
                });
                document.querySelectorAll('.graph-edge, line, path').forEach(l => { 
                    l.style.removeProperty('stroke'); l.style.removeProperty('stroke-width'); 
                });
                
                window.graphEditor.render();
            }

            // Кнопка РОЗФАРБУВАТИ (Хроматичне число)
            const chromaticBtn = document.getElementById('flat-trigger-chromatic-coloring');
            if (chromaticBtn && data.cycleAndChromatic?.coloring) {
                chromaticBtn.onclick = () => {
                    if (window.activeHighlightType === 'chromatic') {
                        resetAllCanvasHighlights();
                        window.activeHighlightType = null;
                        return;
                    }
                    resetAllCanvasHighlights();
                    window.activeHighlightType = 'chromatic';

                    Object.entries(data.cycleAndChromatic.coloring).forEach(([label, colorId]) => {
                        const node = window.graphEditor.nodes.find(n => n.label.toString() === label.toString());
                        if (node) {
                            const colorHex = graphColorPalette[colorId % graphColorPalette.length];
                            const svgNode = document.querySelector(`.node-group[data-id="${node.id}"] circle`);
                            if (svgNode) {
                                svgNode.style.setProperty('fill', colorHex, 'important');
                                svgNode.style.setProperty('stroke', '#1e293b', 'important');
                                svgNode.style.setProperty('stroke-width', '3px', 'important');
                            }
                        }
                    });
                };
            }

            // Кнопка ПОКАЗАТИ (Цикли)
            const cyclesBtn = document.getElementById('flat-trigger-all-cycles');
            if (cyclesBtn && data.cycleAndChromatic?.cyclePath) {
                cyclesBtn.onclick = () => {
                    if (window.activeHighlightType === 'cycles') {
                        resetAllCanvasHighlights();
                        window.activeHighlightType = null;
                        return;
                    }
                    resetAllCanvasHighlights();
                    window.activeHighlightType = 'cycles';

                    const path = data.cycleAndChromatic.cyclePath;
                    for (let i = 0; i < path.length - 1; i++) {
                        const u = window.graphEditor.nodes.find(n => n.label.toString() === path[i].toString());
                        const v = window.graphEditor.nodes.find(n => n.label.toString() === path[i+1].toString());

                        if (u && v) {
                            // Підсвічуємо вершини
                            document.querySelectorAll(`.node-group[data-id="${u.id}"] circle, .node-group[data-id="${v.id}"] circle`).forEach(c => {
                                c.style.setProperty('stroke', '#ef4444', 'important');
                                c.style.setProperty('stroke-width', '4px', 'important');
                            });
                            // Підсвічуємо ребро
                            const edge = window.graphEditor.edges.find(e => 
                                (e.source.toString() === u.id.toString() && e.target.toString() === v.id.toString()) || 
                                (!window.graphEditor.isDirectedGraph && e.source.toString() === v.id.toString() && e.target.toString() === u.id.toString())
                            );
                            if (edge) {
                                const line = document.querySelector(`.edge-weight-group[data-id="${edge.id}"] .graph-edge`);
                                if (line) {
                                    line.style.setProperty('stroke', '#ef4444', 'important');
                                    line.style.setProperty('stroke-width', '5px', 'important');
                                }
                            }
                        }
                    }
                };
            }
        }

        // Перевизначаємо глобальну функцію очищення для інших алгоритмів (Дейкстра, DFS)
        window.clearHighlights = function() {
            window.activeHighlightType = null;
            if (window.graphEditor && typeof window.graphEditor.render === 'function') {
                window.graphEditor.render(); // Це миттєво зітре всі кольори і підсвітки
            }
            const result = document.getElementById('algorithm-result'); 
            if (result) result.innerHTML = '';
        };

        function buildMatrixTable(matrix, labels, clickable) {
            if (!labels || !Array.isArray(labels)) return '<div class="text-muted">Немає даних для матриці</div>';
            let html = '<table class="matrix-table"><thead><tr><th>V \ E</th>';
            labels.forEach(label => html += `<th>${label}</th>`);
            html += '</tr></thead><tbody>';
            for (let i = 0; i < matrix.length; i++) {
                html += '<tr>';
                html += `<th>${labels[i]}</th>`;
                for (let j = 0; j < matrix[i].length; j++) {
                    const value = matrix[i][j] || '0';
                    html += `<td>${value}</td>`;
                }
                html += '</tr>';
            }
            html += '</tbody></table>';
            return html;
        }

        // common clearHighlights function
        function clearHighlights() {
            document.querySelectorAll('.node-group.highlight').forEach(el => el.classList.remove('highlight'));
            document.querySelectorAll('.edge-weight-group.highlight-edge').forEach(el => el.classList.remove('highlight-edge'));

            document.querySelectorAll('.graph-node').forEach(el => { el.style.fill = ""; });
            document.querySelectorAll('.graph-edge').forEach(el => { el.style.stroke = ""; el.style.strokeWidth = ""; });
            
            const result = document.getElementById('algorithm-result'); 
            if (result) result.innerHTML = '';
        }

        // specific highlight function for edges
        function highlightPathByEdges(edgeIds) {
            clearHighlights();
            edgeIds.forEach(id => {
                const g = document.querySelector(`.edge-weight-group[data-id="${id}"]`);
                if (g) g.classList.add('highlight-edge');
            });
            // also highlight nodes by labels if available
        }

        async function runDijkstra() {
            clearHighlights();
            const start = document.getElementById('dijkstra-start').value;
            const end = document.getElementById('dijkstra-end').value;
            if (!start || !end) return alert('Виберіть початкову та кінцеву вершини');
            const dto = buildGraphDto();
            try {
                const resp = await fetch('/api/analysis/dijkstra', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ graphData: JSON.stringify(dto), startId: start.toString(), endId: end.toString() })
                });
                if (!resp.ok) { const err = await resp.json().catch(()=>null); throw new Error(err?.message || 'Помилка'); }
                const r = await resp.json();
                renderDijkstraResult(r);
                if (r.pathEdges && r.pathEdges.length) highlightPathByEdges(r.pathEdges);
            } catch (err) { alert(err.message || err); }
        }

        async function runDfs() {
            clearHighlights();
            const start = document.getElementById('dfs-start').value;
            if (!start) return alert('Виберіть початкову вершину');
            const dto = buildGraphDto();
            try {
                const resp = await fetch('/api/analysis/dfs', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
                    body: JSON.stringify({ graphData: JSON.stringify(dto), startId: start.toString() })
                });
                if (!resp.ok) { const err = await resp.json().catch(()=>null); throw new Error(err?.message || 'Помилка'); }
                const r = await resp.json();
                renderTraversalResult(r, 'dfs-result', 'DFS');
            } catch (err) { alert(err.message || err); }
        }

        async function runBfs() {
            clearHighlights();
            const start = document.getElementById('bfs-start').value;
            if (!start) return alert('Виберіть початкову вершину');
            const dto = buildGraphDto();
            try {
                const resp = await fetch('/api/analysis/bfs', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
                    body: JSON.stringify({ graphData: JSON.stringify(dto), startId: start.toString() })
                });
                if (!resp.ok) { const err = await resp.json().catch(()=>null); throw new Error(err?.message || 'Помилка'); }
                const r = await resp.json();
                renderTraversalResult(r, 'bfs-result', 'BFS');
            } catch (err) { alert(err.message || err); }
        }

        // Floyd-Warshall UI logic
        let floydResult = null;
        let floydCurrentStep = 0;
        let lastFloydHighlighted = null; // {r,c}

        async function runFloydWarshall() {
            clearHighlights();
            lastFloydHighlighted = null;
            const dto = buildGraphDto();
            if (!dto) return alert('Граф відсутній або редактор не готовий');
            try {
                document.getElementById('run-floyd').disabled = true;
                const resp = await fetch('/api/analysis/floyd-warshall', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
                    body: JSON.stringify({ graphData: JSON.stringify(dto) })
                });
                if (!resp.ok) { const err = await resp.json().catch(()=>null); throw new Error(err?.message || 'Помилка'); }
                floydResult = await resp.json();
                floydCurrentStep = 0;
                document.getElementById('floyd-container').style.display = 'block';
                renderFloydStep(floydCurrentStep);
            } catch (err) { alert(err.message || err); }
            finally { document.getElementById('run-floyd').disabled = false; }
        }

        function renderFloydStep(idx) {
            if (!floydResult || !floydResult.steps || floydResult.steps.length === 0) return;
            const step = floydResult.steps[idx];
            const labels = floydResult.labels || [];
            document.getElementById('floyd-step-index').innerText = idx;
            document.getElementById('floyd-step-index-2').innerText = idx;

            // set title: initialization or "Крок N (через vK)"
            if (idx === 0) {
                document.getElementById('floyd-step-title').innerText = 'Ініціалізація (W)';
            } else {
                const kIndex = idx - 1; // steps[1] corresponds to k=0
                const viaLabel = labels[kIndex] || `v${kIndex}`;
                document.getElementById('floyd-step-title').innerText = `Крок ${idx} (через ${viaLabel})`;
            }

            // render distance matrix
            const distHtml = window.buildMatrixTable(step.distanceMatrix, labels, true);
            document.getElementById('floyd-distance').innerHTML = distHtml;
            // render predecessor matrix
            const predHtml = window.buildMatrixTable(step.predecessorMatrix, labels, false);
            document.getElementById('floyd-predecessor').innerHTML = predHtml;

            // attach click handlers to distance cells (toggle highlighting)
            document.querySelectorAll('#floyd-distance .matrix-cell.clickable').forEach(cell => {
                cell.addEventListener('click', (e) => {
                    const r = parseInt(cell.getAttribute('data-row'));
                    const c = parseInt(cell.getAttribute('data-col'));
                    // toggle: if same cell clicked twice -> clear
                    if (lastFloydHighlighted && lastFloydHighlighted.r === r && lastFloydHighlighted.c === c) {
                        clearHighlights();
                        lastFloydHighlighted = null;
                        return;
                    }
                    lastFloydHighlighted = { r, c };
                    highlightPathFromFloyd(r, c);
                });
            });

            // update prev/next button disabled state
            const prevBtn = document.getElementById('floyd-prev');
            const nextBtn = document.getElementById('floyd-next');
            if (prevBtn) prevBtn.disabled = (idx <= 0);
            if (nextBtn) nextBtn.disabled = (floydResult && idx >= floydResult.steps.length - 1);
        }

        document.getElementById('run-floyd')?.addEventListener('click', runFloydWarshall);
        document.getElementById('floyd-prev')?.addEventListener('click', () => { if (floydCurrentStep>0) { floydCurrentStep--; renderFloydStep(floydCurrentStep); } });
        document.getElementById('floyd-next')?.addEventListener('click', () => { if (floydResult && floydCurrentStep < floydResult.steps.length-1) { floydCurrentStep++; renderFloydStep(floydCurrentStep); } });
        document.querySelectorAll('[id="floyd-clear-highlights"]').forEach(btn => {
                btn.addEventListener('click', () => { 
                    clearHighlights(); 
                    lastFloydHighlighted = null; 
                });
        });

        document.addEventListener('DOMContentLoaded', () => {
            // initialize from server data
            if (window.graphEditor && initialData && initialData.nodes) {
                window.graphEditor.nodes = initialData.nodes;
                window.graphEditor.edges = initialData.edges || [];
                window.graphEditor.isDirectedGraph = initialData.directed !== undefined ? initialData.directed : null;

                window.graphEditor.nodeCounter = initialData.nodes.length > 0
                    ? Math.max(...initialData.nodes.map(n => parseInt(n.id.toString().replace('v', '')) || 0)) + 1
                    : 1;

                window.graphEditor.updateToolbarStates();
                window.graphEditor.render();
            }

            // populate selects periodically (keeps UI in sync with canvas)
            populateNodeSelects();
            setInterval(populateNodeSelects, 800);

            document.getElementById('btn-analyze').addEventListener('click', analyzeAll);
            document.getElementById('run-dijkstra').addEventListener('click', runDijkstra);
            document.getElementById('run-dfs').addEventListener('click', runDfs);
            document.getElementById('run-bfs').addEventListener('click', runBfs);

            // Save project handler
            document.getElementById('btn-save-project').addEventListener('click', async () => {
                if (!window.graphEditor) return;

                const btn = document.getElementById('btn-save-project');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Збереження...';
                btn.disabled = true;

                // Формуємо об'єкт так, як очікує бекенд
                const graphDataObj = {
                    nodes: window.graphEditor.nodes,
                    edges: window.graphEditor.edges,
                    directed: window.graphEditor.isDirectedGraph !== null ? window.graphEditor.isDirectedGraph : false
                };

                try {
                    const response = await fetch('/api/project/save', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            projectId: projectId,
                            name: projectName, // Передаємо виключно чисту назву без " - GraphAn"
                            graphData: JSON.stringify(graphDataObj)
                        })
                    });

                    if (response.ok) {
                        alert('✅ Проєкт успішно збережено!');
                    } else {
                        alert('❌ Помилка при збереженні проєкту.');
                    }
                } catch (err) {
                    console.error(err);
                    alert('❌ Помилка з\'єднання з сервером.');
                } finally {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        });
    </script>
}
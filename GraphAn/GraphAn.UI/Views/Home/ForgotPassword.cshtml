@{
    ViewData["Title"] = "Відновлення пароля";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 100px);">
    <div class="card shadow-sm border-0 rounded-4" style="width: 100%; max-width: 420px; background-color: #ffffff;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3 shadow-sm" style="width: 65px; height: 65px;">
                    <i class="fa-solid fa-unlock-keyhole fa-2x"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Забули пароль?</h3>
                <p class="text-muted small">Введіть ваш Email, і ми надішлемо вам інструкції для відновлення доступу</p>
            </div>

            <form id="forgotPasswordForm" method="post">
                <div id="forgot-alert" class="alert d-none rounded-3 py-2 small mb-3 text-center"></div>

                <div class="form-floating mb-4">
                    <input type="email" class="form-control rounded-3" id="emailInput" name="Email" placeholder="name@example.com" required>
                    <label for="emailInput"><i class="fa-solid fa-envelope me-2 text-muted"></i>Електронна пошта</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm mb-3">
                    НАДІСЛАТИ ІНСТРУКЦІЇ
                </button>
            </form>

            <div class="text-center">
                <a asp-controller="Home" asp-action="Login" class="text-primary text-decoration-none fw-bold small">
                    <i class="fa-solid fa-arrow-left me-1 small"></i> Повернутися до входу
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('forgotPasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const alertDiv = document.getElementById('forgot-alert');
            const btn = this.querySelector('button[type="submit"]');

            // Скидаємо стан віджету повідомлень та виключаємо повторні кліки
            alertDiv.classList.add('d-none');
            btn.disabled = true;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Надсилання...';

            const data = {
                email: document.getElementById('emailInput').value
            };

            try {
                // Відправляємо асинхронний запит на ваш API у AuthController
                const response = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();

                if (response.ok) {
                    // Якщо все супер — показуємо красиве зелене повідомлення про успіх
                    alertDiv.textContent = result.message || 'Інструкції зі скидання пароля надіслано на вашу пошту.';
                    alertDiv.className = 'alert alert-success rounded-3 py-2 small mb-3 text-center';
                    alertDiv.classList.remove('d-none');
                    document.getElementById('emailInput').value = ''; // Очищаємо поле вводу
                } else {
                    // Якщо сталася помилка бізнес-логіки (наприклад, пошту не знайдено)
                    alertDiv.textContent = result.message || 'Не вдалося надіслати лист. Перевірте правильність адреси.';
                    alertDiv.className = 'alert alert-danger rounded-3 py-2 small mb-3 text-center';
                    alertDiv.classList.remove('d-none');
                }
            } catch (err) {
                // Якщо сервер лежить або немає інтернету
                alertDiv.textContent = 'Помилка з\'єднання з сервером';
                alertDiv.className = 'alert alert-danger rounded-3 py-2 small mb-3 text-center';
                alertDiv.classList.remove('d-none');
            } finally {
                // Повертаємо кнопку до початкового стану
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });
    </script>
}
